  "contaminantCategories": {
    "Polycyclic Aromatic Hydrocarbons (PAHs)": {
      "description": "Complex organic compounds from combustion, coal tar, and creosote. Common at former gas works, rail yards, and wood treatment sites.",
      "relevantLandUse": ["RLLD","RLHD","AL","PL","CL","IL","WLN","WLR"]
    },
    "BTEX & Petroleum VOCs": {
      "description": "Benzene, Toluene, Ethylbenzene, and Xylenes — volatile compounds found in gasoline and petroleum products. High mobility and toxicity.",
      "relevantLandUse": ["RLLD","RLHD","AL","PL","CL","IL","WLN","WLR"]
    },
    "Metals & Metalloids": {
      "description": "Inorganic contaminants including heavy metals. Found at mining sites, smelters, industrial operations, and some agricultural lands.",
      "relevantLandUse": ["RLLD","RLHD","AL","PL","CL","IL","WLN","WLR"]
    },
    "Chlorinated Compounds": {
      "description": "Synthetic chlorinated chemicals used as solvents, pesticides, and industrial reagents. Persistent in soil and groundwater.",
      "relevantLandUse": ["RLLD","RLHD","AL","PL","CL","IL","WLN","WLR"]
    },
    "Other Organics & Emerging Contaminants": {
      "description": "Includes legacy pesticides (DDT), industrial chemicals, PFAS compounds, and other regulated organic substances.",
      "relevantLandUse": ["RLLD","RLHD","AL","PL","CL","IL","WLN","WLR"]
    }
  },
